{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentRunnerHub",
  "version": "0.1.0",
  "identifier": "com.runner.webapp.appd095b183621fc82f",
  "mainBinaryName": "web-app-native",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentRunnerHub",
        "width": 1000,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "useLocalToolsDir": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      }
    }
  }
}
