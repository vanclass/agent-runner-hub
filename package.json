{
  "name": "web-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:open": "vite --host 127.0.0.1 --open",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test --config .runner/web-app-testing/config.mjs",
    "test:e2e:prepare": "playwright install chromium && node .runner/web-app-testing/readiness.mjs",
    "dev:tauri": "node .runner/web-app-tauri/dev.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.0.0",
    "@playwright/test": "1.56.1",
    "pngjs": "7.0.0",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@tauri-apps/api": "^2.0.0",
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0"
  }
}
